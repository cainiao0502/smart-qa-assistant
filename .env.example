SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/ragent
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-your-db-password

SPRING_REDIS_HOST=127.0.0.1
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=
SPRING_REDIS_DATABASE=0

SILICONFLOW_API_KEY=replace-with-your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

APP_LLM_API_KEY=replace-with-your-minimax-api-key
APP_LLM_BASE_URL=https://api.minimaxi.com/v1
APP_LLM_CHAT_MODEL=MiniMax-M2.7
APP_LLM_EMBEDDING_MODEL=embo-01

# 向量维度，必须与 database.sql 中 document_chunk.embedding 的 VECTOR(维度) 一致。
# 更换 embedding 模型时：若维度不同，需要迁移该列并重建全部文档索引（入库与检索两侧都会按此校验）。
APP_RAG_EMBEDDING_DIM=1024

APP_MCP_REQUEST_TIMEOUT_MS=30000
APP_MCP_ENABLED=false

# 重排序模型（可选，推荐开启）：cross-encoder 对「query+候选」成对打分，精排质量显著高于启发式。
# 默认使用 SiliconFlow 的 BAAI/bge-reranker-v2-m3；未配置 key 或调用失败时自动降级为启发式重排。
AI_RERANK_ENABLED=false
AI_RERANK_MODEL=BAAI/bge-reranker-v2-m3
AI_RERANK_API_KEY=
AI_RERANK_TIMEOUT_MS=10000
APP_RAG_CROSS_ENCODER_ENABLED=false
APP_MCP_TOOL_CACHE_SECONDS=300
APP_MCP_WEBSERVER_ENABLED=false
APP_MCP_WEBSERVER_TYPE=stdio
APP_MCP_WEBSERVER_COMMAND=npx
APP_MCP_WEBSERVER_PACKAGE=@modelcontextprotocol/server-web-search
APP_MCP_WEBSERVER_BASE_URL=
APP_MCP_WEBSERVER_API_KEY=
APP_MCP_WEBSERVER_TOOL_PREFIX=web

APP_MCP_MINIMAXPLAN_ENABLED=false
APP_MCP_MINIMAXPLAN_TYPE=stdio
APP_MCP_MINIMAXPLAN_COMMAND=uvx
APP_MCP_MINIMAXPLAN_PACKAGE=minimax-coding-plan-mcp
APP_MCP_MINIMAXPLAN_TOOL_PREFIX=minimax
APP_MCP_MINIMAXPLAN_WORKDIR=
APP_MCP_MINIMAXPLAN_API_HOST=https://api.minimaxi.com
APP_MCP_MINIMAXPLAN_API_KEY=

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_AGENT_MAX_STEPS=6
APP_AGENT_PLANNER_TIMEOUT_MS=30000
APP_AGENT_TOOL_TIMEOUT_MS=60000

APP_RATELIMIT_CHAT_MAX=10
APP_RATELIMIT_CHAT_WINDOW_SECONDS=60

# 大 chunk 拆片限速（打字机演示效果，每片 10ms）：默认关闭，LLM 流式直发，前端做打字机动画
APP_CHAT_CHUNK_SPLIT_ENABLED=false

# 单请求输入预算：此前五个上下文来源（历史 / 检索切片 / 知识库目录 / 工具补充上下文 / 步骤观察）
# 各自按条数或字符独立裁剪，却没有任何一处与模型窗口比较过，超出时只能等供应商返回 400。
# 开启后超限会按优先级阶梯降级（检索切片 > 对话历史 > 技能目录 > 工具观察 > 文档目录 > 步骤摘要），
# 并在提示词里留下「本节因超出上下文预算省略 N 字符」的痕迹；未超限时行为与关闭时完全一致。
APP_CONTEXT_BUDGET_ENABLED=true
# 模型上下文窗口。多候选路由时请按【最小窗口】配置：供应商切换后若窗口变小，
# 按大窗口配置会出现「原本刚好、切换后溢出」的故障
APP_CONTEXT_WINDOW_TOKENS=128000
# 为生成预留的输出 token 数。
# Planner 请求下发 max_tokens=2048、最终回答下发本值（默认 4096）——输出预留是请求级契约
# 而非假设。修改本值时最终回答的输出上限会自动跟随。
APP_CONTEXT_RESERVED_OUTPUT_TOKENS=4096
# 粗粒度估算器（CJK 按 1 token/字符）偏差约 ±30%，留一成余量
APP_CONTEXT_SAFETY_RATIO=0.9
